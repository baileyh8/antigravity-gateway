# Local example. Set production values before deploying behind HTTPS.
NODE_ENV=development
AGY_MANAGER_HOST=127.0.0.1
AGY_MANAGER_PORT=9898
AGY_MANAGER_ORIGIN=http://127.0.0.1:9898
AGY_MANAGER_COOKIE_SECURE=0
AGY_MANAGER_SERVE_STATIC=1
AGY_GATEWAY_URL=http://127.0.0.1:9897
AGY_ADMIN_USERNAME=admin
AGY_ADMIN_TOKEN_FILE=/absolute/private/admin-token
AGY_SESSION_SECRET_FILE=/absolute/private/session-secret
AGY_MANAGER_DATA_DIR=/absolute/private/manager-data
# Optional: AGY_MANAGER_STATIC_DIR=/absolute/path/to/manager/web/out
# Do not place real tokens or passwords in this example or commit your .env.
