{
  "name": "agy-manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "check": "node -e \"const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process');const walk=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(dir,e.name)):e.name.endsWith('.js')?[path.join(dir,e.name)]:[]);for(const f of walk('src'))cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "fastify": "5.12.7"
  },
  "engines": {
    "node": ">=20"
  }
}
