{
  "name": "antigravity-gateway",
  "version": "1.7.1-bailey.49",
  "description": "Bailey-maintained Anthropic/OpenAI-compatible gateway with managed accounts, per-account proxies, multimodal APIs and bounded concurrency.",
  "license": "MIT",
  "type": "commonjs",
  "main": "antigravity-gateway.js",
  "files": [
    "antigravity-gateway.js",
    "src/",
    "scripts/",
    "skills/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "native/",
    "docs/agy-1.5.7-compatibility.md",
    "docs/agy-1.5.9-compatibility.md"
  ],
  "bin": {
    "antigravity-gateway": "antigravity-gateway.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "undici": "^6.29.1",
    "ws": "8.22.0"
  },
  "scripts": {
    "start": "node antigravity-gateway.js",
    "postinstall": "node scripts/check-environment.js",
    "check": "node -e \"const fs=require('node:fs'),cp=require('node:child_process');const files=['antigravity-gateway.js',...fs.readdirSync('src').filter(f=>f.endsWith('.js')).map(f=>'src/'+f),...fs.readdirSync('scripts').filter(f=>f.endsWith('.js')).map(f=>'scripts/'+f)];for(const f of files)cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "test": "node --test tests/*.test.js",
    "build:native": "node scripts/build-native-transport.js",
    "check:native": "node -e \"const cp=require('node:child_process');for(const f of ['src/agy-native-transport.js','src/agy-request-profile.js','src/agy-session-state.js','src/agy-file-lease.js','src/agy-context-state.js','src/agy-image-references.js','src/agy-tool-results.js','src/agy-structured-output.js','scripts/build-native-transport.js','src/agy-157-tool-contract.js','src/antigravity-model-config.js','src/account-storage-permissions.js'])cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "manager:check": "npm --prefix manager/server run check",
    "manager:test": "npm --prefix manager/server test && npm --prefix manager/web test",
    "manager:build": "npm --prefix manager/web run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "antigravity",
    "gemini",
    "anthropic-compatible",
    "openai-compatible",
    "claude-code",
    "codex-cli",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baileyh8/antigravity-gateway.git"
  },
  "homepage": "https://github.com/baileyh8/antigravity-gateway#readme",
  "bugs": {
    "url": "https://github.com/baileyh8/antigravity-gateway/issues"
  }
}
